# =============================================================
# Poker Decision Intelligence Framework V2 - 环境变量示例
# 复制为 .env 后填写；所有变量均可为空，系统会降级到 Mock。
# config.yaml 中已用 ${ENV:VAR:-默认值} 引用这些变量：
# 写 .env（或设置环境变量）即可切换 Provider，无需改 config.yaml 与任何代码。
# =============================================================

# ---- LLM Provider ----
# 可选值: mock | openai | kimi | deepseek | claude | anthropic | gemini
#   openai/kimi/deepseek/gemini → OpenAI 兼容通道（端点自动）
#   claude/anthropic           → Anthropic Messages API
LLM_PROVIDER=mock
# Fast/Deep 双模型：fast=实时快路径；deep=Research/Deep 模式。
# 留空 → 使用所选 Provider 的默认模型（kimi=moonshot-v1-8k/32k，
# deepseek=deepseek-chat/reasoner，openai=gpt-4o-mini/4o 等）。
LLM_MODEL=
LLM_DEEP_MODEL=
LLM_BASE_URL=
# Key：直接填 LLM_API_KEY，或指定存放 Key 的环境变量名（默认就是 LLM_API_KEY）
LLM_API_KEY_ENV=LLM_API_KEY
LLM_API_KEY=
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_S=60
LLM_MAX_TOKENS=2048
# 成本统计（USD / 1M tokens；不填则不统计成本）
LLM_PRICE_IN_PER_1M=
LLM_PRICE_OUT_PER_1M=

# ---- Vision Provider ----
# 可选值: mock | multimodal（需 LLM_PROVIDER 为支持图像的模型）
VISION_PROVIDER=mock
VISION_MODEL=

# ---- Solver Provider ----
# 可选值: mock | postflop
SOLVER_PROVIDER=mock
POSTFLOP_SOLVER_PATH=

# ---- 应用 ----
POKER_AI_CONFIG=configs/config.yaml
POKER_AI_ENV=dev
POKER_AI_LOG_LEVEL=INFO
